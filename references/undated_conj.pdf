  <script>
      var swiper = new Swiper(".mySwiper", {
        slidesPerView: 1,
        spaceBetween: 30,
        loop: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        autoplay: {
          delay: 5000,
        },
      });
      function tab(class1, class2, class3) {
        $(class1).mouseenter(function () {
          const index = $(this).index();
          console.log(index);
          $(this).addClass("tab_tite").siblings().removeClass("tab_tite");
          $(class2).eq(index).show().siblings(class2).hide();
          $(class3).eq(index).show().siblings(class3).hide();
        });
      }
      tab(
        ".main_left .letitle ul li",
        ".main_left .top_ul",
        ".main_left .gd a"
      );
   /*   tab(
        ".main_right .letitle ul li",
        ".main_right .tab1",
        ".main_right .gd a"
      ); */
    </script>
